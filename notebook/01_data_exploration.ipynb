# notebooks/01_data_exploration.ipynb
"""
# Heart Failure Readmission Project - Phase 1: Data Exploration

## Overview
This notebook explores the synthetic EHR data for heart failure patients.

## Setup
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime, timedelta
import warnings
warnings.filterwarnings('ignore')

# Set style
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_palette("husl")

# Load the processed data
print("Loading data...")
df = pd.read_csv('../data/processed/full_dataset.csv')
print(f"Data shape: {df.shape}")
print(f"Columns: {df.columns.tolist()}")

"""
## 1. Basic Statistics
"""

print("\n=== BASIC STATISTICS ===")
print(f"Total patients: {len(df)}")
print(f"Readmission rate: {df['readmitted_30d'].mean():.2%}")
print(f"Average age: {df['age'].mean():.1f} ± {df['age'].std():.1f}")
print(f"Average length of stay: {df['length_of_stay'].mean():.1f} days")

# Display first few rows
print("\nFirst 5 rows:")
display(df.head())

# Data types and missing values
print("\nData types and missing values:")
info_df = pd.DataFrame({
    'dtype': df.dtypes,
    'missing': df.isnull().sum(),
    'missing_%': (df.isnull().sum() / len(df) * 100).round(2)
})
display(info_df)

"""
## 2. Target Variable Analysis
"""

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Readmission distribution
axes[0].pie(df['readmitted_30d'].value_counts(), 
           labels=['Not Readmitted', 'Readmitted'],
           autopct='%1.1f%%', colors=['lightblue', 'salmon'])
axes[0].set_title('30-Day Readmission Distribution')

# Readmission by time to readmit (for those readmitted)
readmitted = df[df['readmitted_30d'] == 1]
if not readmitted.empty and 'days_to_readmit' in readmitted.columns:
    axes[1].hist(readmitted['days_to_readmit'].dropna(), bins=15, edgecolor='black')
    axes[1].set_xlabel('Days to Readmission')
    axes[1].set_ylabel('Count')
    axes[1].set_title('Distribution of Days to Readmission')
    axes[1].axvline(x=readmitted['days_to_readmit'].median(), color='red', 
                   linestyle='--', label=f'Median: {readmitted["days_to_readmit"].median():.1f} days')
    axes[1].legend()

plt.tight_layout()
plt.savefig('../reports/eda/target_analysis.png', dpi=300, bbox_inches='tight')
plt.show()

"""
## 3. Demographic Analysis
"""

demographic_cols = ['age', 'gender', 'race', 'insurance_type']
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
axes = axes.flatten()

for i, col in enumerate(demographic_cols[:4]):
    if col in df.columns:
        ax = axes[i]
        
        if df[col].dtype == 'object' or df[col].dtype.name == 'category':
            # Categorical: show readmission rates by category
            rate_df = df.groupby(col)['readmitted_30d'].mean().reset_index()
            rate_df = rate_df.sort_values('readmitted_30d', ascending=False)
            
            bars = ax.bar(range(len(rate_df)), rate_df['readmitted_30d'])
            ax.set_xticks(range(len(rate_df)))
            ax.set_xticklabels(rate_df[col], rotation=45, ha='right')
            ax.set_ylabel('Readmission Rate')
            ax.set_title(f'Readmission Rate by {col}')
            
            # Add value labels on bars
            for j, bar in enumerate(bars):
                height = bar.get_height()
                ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,
                       f'{height:.1%}', ha='center', va='bottom')
        else:
            # Numerical: show distribution by readmission status
            sns.boxplot(x='readmitted_30d', y=col, data=df, ax=ax)
            ax.set_xlabel('Readmitted')
            ax.set_ylabel(col)
            ax.set_title(f'{col} by Readmission Status')

plt.tight_layout()
plt.savefig('../reports/eda/demographic_analysis.png', dpi=300, bbox_inches='tight')
plt.show()

"""
## 4. Clinical Features Analysis
"""

clinical_cols = ['last_bnp', 'last_creatinine', 'comorbidity_score', 'length_of_stay',
                'has_hypertension', 'has_diabetes', 'has_cad', 'has_copd']

fig, axes = plt.subplots(2, 4, figsize=(16, 8))
axes = axes.flatten()

for i, col in enumerate(clinical_cols[:8]):
    ax = axes[i]
    
    if col in df.columns:
        if df[col].dtype in ['int64', 'float64']:
            # Numerical features
            sns.violinplot(x='readmitted_30d', y=col, data=df, ax=ax, inner='quartile')
            ax.set_xlabel('Readmitted')
            ax.set_ylabel(col)
        else:
            # Binary features
            rate_df = df.groupby(col)['readmitted_30d'].mean().reset_index()
            ax.bar([str(x) for x in rate_df[col]], rate_df['readmitted_30d'])
            ax.set_xlabel(col)
            ax.set_ylabel('Readmission Rate')
            
            # Add value labels
            for j, (_, row) in enumerate(rate_df.iterrows()):
                ax.text(j, row['readmitted_30d'] + 0.01, 
                       f'{row["readmitted_30d"]:.1%}', ha='center')
        
        ax.set_title(f'{col}')

plt.tight_layout()
plt.savefig('../reports/eda/clinical_features.png', dpi=300, bbox_inches='tight')
plt.show()

"""
## 5. Correlation Analysis
"""

# Select numerical columns
numerical_cols = df.select_dtypes(include=[np.number]).columns.tolist()
# Remove ID columns and target variable for correlation matrix
exclude_cols = ['readmitted_30d', 'patient_id', 'index_encounter_id', 'died_within_30d']
corr_cols = [col for col in numerical_cols if col not in exclude_cols]

corr_matrix = df[corr_cols].corr()

plt.figure(figsize=(12, 10))
mask = np.triu(np.ones_like(corr_matrix, dtype=bool))
sns.heatmap(corr_matrix, mask=mask, annot=True, fmt='.2f', cmap='coolwarm',
           center=0, square=True, linewidths=.5, cbar_kws={"shrink": .8})
plt.title('Correlation Matrix of Clinical Features')
plt.tight_layout()
plt.savefig('../reports/eda/correlation_matrix_detailed.png', dpi=300, bbox_inches='tight')
plt.show()

# Top correlations with readmission
if 'readmitted_30d' in df.columns:
    correlations = df[corr_cols + ['readmitted_30d']].corr()['readmitted_30d'].sort_values(ascending=False)
    print("\nTop correlations with readmission:")
    display(pd.DataFrame(correlations).round(3).head(10))

"""
## 6. Feature Importance (Preliminary)
"""

from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import cross_val_score
import eli5
from eli5.sklearn import PermutationImportance

# Prepare data for quick feature importance
X = df[corr_cols].fillna(df[corr_cols].median())
y = df['readmitted_30d']

# Quick Random Forest to get feature importance
rf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)
rf.fit(X, y)

# Get feature importance
feature_importance = pd.DataFrame({
    'feature': X.columns,
    'importance': rf.feature_importances_
}).sort_values('importance', ascending=False)

plt.figure(figsize=(10, 8))
bars = plt.barh(range(15), feature_importance['importance'].head(15)[::-1])
plt.yticks(range(15), feature_importance['feature'].head(15)[::-1])
plt.xlabel('Feature Importance (Random Forest)')
plt.title('Top 15 Features by Importance')
plt.tight_layout()

# Add value labels
for i, bar in enumerate(bars):
    width = bar.get_width()
    plt.text(width + 0.001, bar.get_y() + bar.get_height()/2,
            f'{width:.3f}', ha='left', va='center')

plt.savefig('../reports/eda/feature_importance.png', dpi=300, bbox_inches='tight')
plt.show()

print("\nTop 10 features by importance:")
display(feature_importance.head(10))

"""
## 7. Data Quality Check
"""

print("\n=== DATA QUALITY CHECKS ===")

# Check for impossible values
print("\n1. Value ranges check:")
checks = {
    'Age reasonable (0-120)': df['age'].between(0, 120).all(),
    'Length of stay positive': (df['length_of_stay'] >= 0).all(),
    'BNP positive': (df['last_bnp'] > 0).all() if 'last_bnp' in df.columns else True,
    'Creatinine positive': (df['last_creatinine'] > 0).all() if 'last_creatinine' in df.columns else True
}

for check_name, check_result in checks.items():
    print(f"{check_name}: {'✓' if check_result else '✗'}")

# Check for duplicates
print(f"\n2. Duplicate patients: {df['patient_id'].duplicated().sum()}")

# Check class balance
class_balance = df['readmitted_30d'].value_counts(normalize=True)
print(f"\n3. Class balance: Not readmitted={class_balance[0]:.1%}, Readmitted={class_balance[1]:.1%}")

"""
## 8. Summary Statistics Table
"""

# Create summary table
summary = pd.DataFrame({
    'Variable': [],
    'Type': [],
    'N': [],
    'Missing (%)': [],
    'Mean/Count': [],
    'SD/%': [],
    'Min': [],
    'Max': []
})

for col in df.columns:
    if col not in ['patient_id', 'index_encounter_id', 'index_admission', 
                   'index_discharge', 'readmission_date']:
        row = {
            'Variable': col,
            'Type': str(df[col].dtype),
            'N': df[col].count(),
            'Missing (%)': f"{df[col].isnull().mean():.1%}",
        }
        
        if pd.api.types.is_numeric_dtype(df[col]):
            row.update({
                'Mean/Count': f"{df[col].mean():.2f}",
                'SD/%': f"{df[col].std():.2f}",
                'Min': f"{df[col].min():.2f}",
                'Max': f"{df[col].max():.2f}"
            })
        else:
            # For categorical, show top category
            top_val = df[col].value_counts().index[0] if not df[col].isnull().all() else 'N/A'
            top_pct = df[col].value_counts(normalize=True).iloc[0] if not df[col].isnull().all() else 0
            row.update({
                'Mean/Count': str(top_val),
                'SD/%': f"{top_pct:.1%}",
                'Min': 'N/A',
                'Max': 'N/A'
            })
        
        summary = pd.concat([summary, pd.DataFrame([row])])

summary = summary.reset_index(drop=True)
summary.to_csv('../reports/eda/summary_statistics.csv', index=False)

print("\nSummary statistics saved to '../reports/eda/summary_statistics.csv'")
display(summary.head(10))

